# Configuration du connecteur nemeton distant (voir ?nemetonmcp::config_distant).
# Copier en /etc/nemetonmcp.env (droits 600, proprietaire nemeton).
# Les anciennes variables NEMETON_CLAUDE_* (avant 0.8.0) sont encore lues,
# avec un avertissement, quand la NEMETON_MCP_* correspondante manque.

# URL publique, telle que claude.ai la joint (sans /mcp).
NEMETON_MCP_URL=https://nemeton.example.org
# Realm Keycloak qui delivre les jetons (meme variable que nemetonshiny).
NEMETON_KEYCLOAK_URL=https://auth.example.org/realms/nemeton
# Audiences acceptees dans les jetons (mappeurs d'audience du client Keycloak),
# separees par des virgules : il suffit que le jeton en porte une. Pour passer
# a l'audience nemeton-mcp sans coupure : ajouter son mappeur dans Keycloak,
# mettre nemeton-mcp,nemeton-claude ici, puis retirer nemeton-claude (et son
# mappeur) quand tous les jetons en circulation portent nemeton-mcp.
NEMETON_MCP_AUDIENCE=nemeton-claude
# Cle des liens de telechargement : openssl rand -hex 32
NEMETON_MCP_SECRET=
# Roles Keycloak (realm) : lecture, et ecriture (creer, calculer, exporter).
NEMETON_MCP_ROLES_LECTURE=lecteur,gestionnaire,admin
NEMETON_MCP_ROLES_ECRITURE=gestionnaire,admin
# collectif : tous les comptes voient les memes projets (comme nemetonshiny).
# utilisateur : un dossier de projets par compte.
NEMETON_MCP_ISOLATION=collectif
NEMETON_MCP_PORT=8765
# Dossier des projets nemeton, et des fichiers ecrits pour les vues.
NEMETON_PROJECT_DIR=/srv/nemeton/projets
NEMETON_MCP_VUES_DIR=/srv/nemeton/vues
LANG=C.UTF-8
