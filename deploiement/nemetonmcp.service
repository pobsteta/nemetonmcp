# Service systemd du connecteur nemeton distant.
# /etc/systemd/system/nemetonmcp.service, puis :
#   systemctl daemon-reload && systemctl enable --now nemetonmcp
[Unit]
Description=Connecteur MCP nemeton (HTTP, Keycloak)
After=network-online.target
Wants=network-online.target

[Service]
User=nemeton
Group=nemeton
EnvironmentFile=/etc/nemetonmcp.env
ExecStart=/usr/bin/Rscript -e "nemetonmcp::serveur_mcp_distant()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
# Lecture seule plutot que masque : les paquets R installes dans ~/R restent lisibles.
ProtectHome=read-only
ReadWritePaths=/srv/nemeton
PrivateTmp=true

[Install]
WantedBy=multi-user.target
